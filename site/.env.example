# Copy to .env. Compose refuses to start without the required ones.
DATABASE_URL=file:./data/payload.db
PAYLOAD_SECRET=            # required: openssl rand -hex 32
SERVER_URL=                # the public origin once the hostname is live; locally http://localhost:3001
ADMIN_EMAIL=               # required: the first admin user, made on an empty site
ADMIN_PASSWORD=            # required
